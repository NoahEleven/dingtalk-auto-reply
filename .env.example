# ============================================================
# 钉钉自动回复 · 配置样例
# 用法：复制本文件为同目录 .env，按需修改后启动脚本
#       cp .env.example .env
# 说明：所有项均可选。留空 = 自动探测 / 使用默认值。
#       已存在的系统环境变量不会被本文件覆盖。
# ============================================================

# ---------- CodeBuddy 认证（二选一，推荐方式二做无人值守） ----------
# 方式一（推荐无人值守）：填 API Key，脚本用 Key 认证，不依赖交互登录
# 申请：https://copilot.tencent.com 控制台 → API Key
# CODEBUDDY_API_KEY=

# 方式二（零配置）：留空，复用你已在终端 `codebuddy` 登录过的凭据
# 未登录时脚本启动会打印提示，让你去终端登录。

# 网络环境：auto 检测（中国版 copilot.tencent.com 会自动识别）。
# 需要时强制覆盖：internal=中国版 / public=国际版
# CODEBUDDY_INTERNET_ENVIRONMENT=internal

# ---------- CodeBuddy Agent SDK 运行环境（安装时由 _setup_env.py 自动写入） ----------
# 装了 codebuddy-agent-sdk 的 python 解释器绝对路径。monitor 启动时若被「没装 SDK 的
# python」拉起，会按本项用 os.execv 重拉到这个 python，保证 SDK 一定可用。
# 留空 = 用当前解释器（要求自身已装 SDK）。安装脚本 _setup_env.py 会自动探测并写入本项。
# CODEBUDDY_SDK_PYTHON=~/.workbuddy/binaries/python/envs/default/Scripts/python.exe
# 以下为 SDK 调用所需的模型/网络/CLI（详见上文「CodeBuddy 认证」段，这里集中列出供 agent 识别）：
# CODEBUDDY_MODEL=deepseek-v4-flash            # 文本 + 视觉主模型（视觉默认跟随它）
# CODEBUDDY_INTERNET_ENVIRONMENT=internal   # internal=中国版 / public=国际版（留空=自动探测）
# CODEBUDDY_CMD=                            # codebuddy CLI 路径（留空=自动探测）
# ⚠️ CODEBUDDY_API_KEY 见上方「CodeBuddy 认证」段；若无 key 则复用 CLI 已登录凭据。

# ---------- 外部二进制路径（一般无需改，自动探测 ~/.workbuddy 下） ----------
# CodeBuddy CLI（codebuddy.cmd）。留空=自动 glob 受管 node 目录。
# CODEBUDDY_CMD=
# Node 运行时（调 dws/微信推送用）。留空=自动探测。
# NODE=
# dws CLI 路径。留空=自动探测。
# DWS_CMD=
# 微信主动推送 send.js。留空=自动探测 weixinclaw-proactive-push skill。
# WEIXIN_SEND_JS=

# ---------- 工作空间（cwd） ----------
# 钉钉自动回复工作空间路径：CodeBuddy 会将该目录下的 .workbuddy/memory/*.md
# 作为工作空间记忆自动加载；agent 也会按需 Read（含 KNOWLEDGE.md / MEMORY.md /
# 你留下的项目&资料库）。换机器或路径不同时覆盖此项。
# 默认 ~/WorkBuddy/dingtalk_auto_reply（目录由你手动创建，agent 不会自动 mkdir）。
# DINGTALK_WORKSPACE=~/WorkBuddy/dingtalk_auto_reply

# ---------- 行为参数 ----------
# 轮询间隔（秒）
# POLL_INTERVAL=10
# 抢答防护：发现未读后等待多久才代发（秒），给老板自己回的时间
# REPLY_DELAY_SEC=120
# 抢答防护：判定"老板正在跟"的活跃窗口（秒），窗口内老板发过消息则取消代发
# ACTIVE_WINDOW_SEC=300
# 不自动回复的名单（逗号分隔昵称/关键字），命中只通知不代发
# SKIP_SENDERS=
# 老板本人标识（逗号分隔），用于"避免回复自己"的兜底昵称匹配
# 隐私：填你自己的钉钉昵称/英文名，别留真实名在分发模板里。源码默认仅含中性词"老板"。
# SELF_SENDERS=你的昵称,你的英文名
# 群聊 @我 检测：老板的群昵称候选（逗号分隔），群消息 "@昵称" 前缀命中即判"有人@你"
# MENTION_NAMES=你的群昵称
# 通讯录搜索用的钉钉显示名（探测本人 openDingTalkId 的兜底；留空则跳过搜索）
# BOSS_DISPLAY_NAME=你的钉钉显示名
# 更精确：直接指定本人 openDingTalkId（配了这个就不需要 BOSS_DISPLAY_NAME）
# SELF_OPENDINGTALK_ID=
# 公司身份与职位（仅用于回复人设"你是某公司某职位员工、平级回同事"，源代码不硬编码隐私）
# 例：BOSS_COMPANY=某科技公司（ExampleCorp）  BOSS_TITLE=软件工程师
# BOSS_COMPANY=
# BOSS_TITLE=
# 群聊微信推送策略（仅影响群消息是否推微信；单聊代复+提醒不受影响）：
#   atme = 仅 @我 / @all 才推（默认，最清净，过滤群刷屏/特别关注发言）
#   all  = 所有群消息都推（旧行为）
#   off  = 群聊完全不推微信（连@我都不推）
# GROUP_PUSH=atme

# 群聊 AI 草稿预览（可选能力，默认关）：开启后群聊 @我 且有文本的消息复用单聊机制
# （2min 延迟 + 背景历史 + AI 生成回复），但生成结果【绝不发钉钉群】——只推微信给本人预览验证。
# 验证期用；确认草稿后再另行代发。GROUP_REPLY_PREVIEW=1 开启。
# GROUP_REPLY_PREVIEW=0

# ---------- 本地代码库检索（可选能力，通用配置，不绑定任何特定项目） ----------
# 分号(;)分隔的本地源码库绝对路径列表。配置后，回复 agent 可检索这些
# 源码库，回答「源码 / 接口 / 实现细节」类问题（话题名、节点名、参数名、launch/配置文件、
# 具体 .py/.cpp 实现逻辑等），与 gbrain 文档知识互补。
# 不填 = 不启用代码检索（agent 走 gbrain + 工作空间本地文档即可），通用 skill 默认留空。
# Windows 路径用反斜杠或正斜杠均可（如 E:\code\ros2_ws\src 或 E:/code/ros2_ws/src）。
# 多个路径用英文分号分隔；不存在/不可读的路径会被自动忽略，不影响其它路径。
# CODE_SEARCH_ROOTS=
#
# 代码检索工具 search.py（可选，rg 全文搜索 + ctags 符号定位的封装脚本，装法见 SKILL.md）：
# 配置后 agent 优先用 Bash 调它检索（比裸 Grep 全库扫更快更准，支持 --pkg 限定包/--symbol 定位符号）。
# 默认自动探测 ~/.workbuddy/tools/code-search/search.py；装到其它路径时用本项覆盖。
# CODE_SEARCH_TOOL=

# ---------- 多维表 grounding · 老板专属配置（隐私：只在此填，源码零硬编码） ----------
# 以下全部可选；不填则自动退化为「纯人设代复」（不查表，与老板身份无关，照样能代回）。
# 填了才会按意图预拉钉钉多维表做事实 grounding（"结合你项目进度回"）。
# 查表用的 dws 权限：需 `dws patch chmod` 授权 aitable:read 等（详见 SKILL.md「dws 依赖」）。
# 总开关：回复前是否按意图预拉多维表做事实 grounding（默认开；设 0 全关，纯人设代复）。
# TABLE_GROUNDING=1

# 老板在钉钉的身份（userId）；过滤"我名下"项目/待办统一用这个。
# 新用户务必在 .env 填你自己的钉钉 userId（在钉钉通讯录/个人资料里查），源码默认空串会强制要求配置。
# BOSS_UID=
# 老板钉钉昵称/姓名（仅用于查表提示词的人称，如"X名下"）；不填默认中性词"老板"。
# BOSS_NAME=你的钉钉昵称

# ① 问题反馈表（待解决问题表）
# FB_BASE=你的表 baseId
# FB_TAB=你的表 tableId
# FB_STATUS=解决状态字段 ID（值≠"已解决"即待解决）
# FB_HANDLER=处理人字段 ID（成员字段，userId 匹配 BOSS_UID）
# FB_SUMM=问题概要字段 ID

# ② ROS 软件项目表（在跑项目表）
# ROS_BASE=你的表 baseId
# ROS_TAB=你的表 tableId
# ROS_PROG=进度字段 ID（值形如 "0.8"/"1"）
# ROS_OWNER=负责人字段 ID（成员字段，userId 匹配 BOSS_UID）
# ROS_NAME=项目名称字段 ID

# ---------- 图片识别（多模态） ----------
# 后端：与文本回复同一套 CodeBuddy Agent SDK（多模态），零额外 key、图片不出域。
# 只要 CodeBuddy SDK 可用即自动启用识别，无需任何 key。
# 视觉模型默认跟随文本主模型（CODEBUDDY_MODEL，即 deepseek-v4-flash）；如需单独指定 CodeBuddy 侧
# 的视觉模型，用 VISION_MODEL 覆盖（仍是 CodeBuddy 模型，非外部 API）。
# VISION_MODEL=
# 单聊图片是否 AI 自动代复（基于"文字说明+图片描述"生成回复）。
# 默认开：图片消息也自动代复（老板要求「图片也默认代复」）。
# 设为 0 关闭（降级为仅识别+微信通知，不代发，防社死）：AUTO_REPLY_IMAGE=0
# 调试日志 / 审计日志 / 状态文件位置（默认 ~/.workbuddy 下）
# DEBUG_LOG=~/.workbuddy/dingtalk_auto_debug.log
# AUDIT_LOG=~/.workbuddy/dingtalk_auto_audit.jsonl
# STATE_FILE=~/.workbuddy/dingtalk_auto_state.json
# 观察 agent 流式执行轨迹（思考/工具调用/结果，[agent-trace] 日志块，默认关防刷屏）：
# DEBUG_AGENT_TRACE=1
